{
  "name": "football-elite-3d",
  "productName": "Football Elite 3D",
  "version": "1.0.0",
  "description": "Football Elite 3D - juego de fútbol 3D 11 contra 11",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/single-file.mjs",
    "start": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "electron": "electron .",
    "package": "npm run build && node scripts/package.mjs",
    "test:e2e:mobile": "node scripts/e2e-mobile.mjs",
    "test:e2e:gamepad": "node scripts/e2e-gamepad.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "build:single": "npm run build",
    "art": "npm run build && node scripts/make-art.mjs all",
    "server": "node server/index.mjs",
    "test:e2e:online": "node scripts/e2e-online.mjs",
    "test:e2e:file": "node scripts/e2e-file.mjs index.html",
    "test:audio": "node scripts/e2e-audio.mjs",
    "prepare": "node scripts/hooks.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^4.1.1",
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "three": "^0.170.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@electron/packager": "^18.3.6",
    "@types/three": "^0.170.0",
    "electron": "^33.2.1",
    "playwright-core": "^1.56.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
